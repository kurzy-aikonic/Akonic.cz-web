"<!doctype html>\n<html lang=\"cs\">\n<head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>AIKONIC – Dotační kalkulačka</title>\n<style>\n:root{--ink:#17171b;--muted:#727783;--line:#e8e8ee;--bg:#f7f7fa;--card:#fff;--p:#6f55ff;--b:#4f82ff;--soft:#f3f0ff;--ok:#18794e;--warn:#a15c00;--danger:#b42318}\n*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,#fbfbfd,#f5f6fa);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink)}\n.wrap{max-width:1120px;margin:auto;padding:58px 22px}.pill{display:inline-flex;background:var(--soft);color:#5d49df;border:1px solid #e0dbff;border-radius:999px;padding:7px 11px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}\nh2{font-size:clamp(38px,6vw,66px);line-height:1;letter-spacing:-.045em;max-width:880px;margin:18px 0 16px}.lead{font-size:18px;color:#555a64;line-height:1.55;max-width:780px}.trust{margin:18px 0 34px;color:#6c717b;font-size:14px}.shell{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start}\n.card{background:#fff;border:1px solid var(--line);border-radius:24px;padding:28px;box-shadow:0 18px 55px rgba(25,28,40,.055)}\n.step{font-size:12px;color:#8b909a;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px}.q{font-size:23px;font-weight:800;letter-spacing:-.02em;margin-bottom:16px}\n.employment-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:10px}.employment-card{border:1px solid #dddfe6;border-radius:16px;padding:14px}.employment-card h3{margin:0 0 4px;font-size:17px}.employment-card p{margin:0 0 12px;color:#777d87;font-size:12px;line-height:1.35}\n.numrow{display:flex;align-items:center;border:1px solid #dddfe6;border-radius:14px;overflow:hidden;background:#fff}.numrow button{width:42px;height:44px;border:0;background:#f7f7fa;font-size:20px;cursor:pointer}.numrow button:disabled{opacity:.35;cursor:not-allowed}.numrow input{flex:1;min-width:0;height:44px;border:0;text-align:center;font-size:17px;font-weight:800;outline:0;background:#fff}\n.eligibility-note{margin:10px 0 24px;padding:12px 14px;border-radius:12px;background:#f8f8fa;color:#666d78;font-size:13px;line-height:1.45}\n.programs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:4px}.program{border:1px solid #dddfe6;border-radius:16px;padding:16px;cursor:pointer;position:relative}.program.active{border:2px solid #755fff;background:#fbfaff;padding:15px}.program strong{font-size:18px}.program p{margin:5px 0 0;color:#707681;font-size:13px}.badge{display:inline-block;margin-top:9px;font-size:10px;font-weight:800;background:#eeeaff;color:#604ce1;padding:5px 7px;border-radius:999px}\n.allocHeader{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:10px}.allocStatus{font-size:12px;line-height:1.4;padding:7px 10px;border-radius:999px;background:#f7f7fa;color:#666d78;white-space:nowrap}.allocStatus.ok{background:#eef9f3;color:var(--ok)}.allocStatus.warn{background:#fff6e8;color:var(--warn)}\n.manualGroups{display:grid;gap:10px}.editGroup{border:1px solid var(--line);border-radius:16px;padding:14px;background:#fff}.editGroup.invalid{border-color:#f2b8b5;background:#fffafa}.editHead{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:10px}.editHead strong{font-size:15px}.capacity{font-size:11px;font-weight:800;padding:5px 8px;border-radius:999px;background:#f1efff;color:#6152ca}.capacity.full{background:#eef9f3;color:var(--ok)}.capacity.bad{background:#fff0ef;color:var(--danger)}\n.groupInputs{display:grid;grid-template-columns:1fr 1fr;gap:8px}.gfield{background:#f8f8fa;border-radius:12px;padding:10px}.gfield label{display:block;font-size:11px;color:#737984;margin-bottom:7px;font-weight:700}.gfield .numrow{background:#fff}.gfield .numrow button{height:38px;width:36px}.gfield .numrow input{height:38px;font-size:15px}\n.remainder{margin-top:10px;font-size:12px;color:#6d737d;line-height:1.45}.remainder strong{color:#333740}.helperRow{display:flex;gap:8px;margin-top:12px}.helperBtn{flex:1;border:1px solid #dddfe6;background:#fff;border-radius:11px;padding:10px 12px;font-weight:750;font-size:12px;cursor:pointer;color:#555c67}.helperBtn:hover{background:#fafafe}\n.result{background:linear-gradient(145deg,#faf8ff,#f4f7ff);border:1px solid #ded9ff;border-radius:22px;padding:26px;position:relative;overflow:hidden}.result:after{content:\"\";position:absolute;width:230px;height:230px;border-radius:50%;background:rgba(113,85,255,.09);right:-90px;top:-120px}.kicker{font-size:13px;color:#756aa1;text-transform:uppercase;font-weight:800;letter-spacing:.08em;position:relative;z-index:1}.big{font-size:clamp(42px,6vw,66px);font-weight:900;letter-spacing:-.055em;margin:4px 0;position:relative;z-index:1}.sum{color:#747983;position:relative;z-index:1}\n.breakdown{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:12px}.mini{border:1px solid var(--line);border-radius:16px;padding:16px;background:#fff}.mini b{display:block;font-size:22px;margin-bottom:3px}.mini span{color:#7a808b;font-size:13px}.mini.balance{grid-column:1/-1;background:linear-gradient(145deg,#f2fbf6,#f8fffb);border-color:#cfe9da}.mini.balance b{font-size:30px;color:var(--ok)}.mini.balance.negative{background:#fff7f6;border-color:#f1cbc7}.mini.balance.negative b{color:var(--danger)}.insight{margin:14px 0;background:#f8f8fa;border-radius:14px;padding:14px 16px;color:#565c66;font-size:14px;line-height:1.45}.insight.warn{background:#fff7ea;color:#7a4a00}.insight.ok{background:#eff9f3;color:#17613f}\n.groupsTitle{margin:20px 0 10px;font-size:15px;font-weight:850}.groups{display:grid;gap:10px}.groupCard{border:1px solid var(--line);border-radius:16px;padding:15px;background:#fff}.groupHead{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:10px}.groupHead strong{font-size:15px}.groupBadge{font-size:11px;font-weight:800;padding:5px 8px;border-radius:999px;background:#f1efff;color:#6152ca}.groupMeta{font-size:12px;color:#7c828d;margin-top:2px}.groupNums{display:grid;grid-template-columns:1fr 1fr;gap:8px}.groupNum{background:#f8f8fa;border-radius:12px;padding:10px 12px}.groupNum b{display:block;font-size:17px}.groupNum span{font-size:11px;color:#7d838d}\n.cta{width:100%;border:0;border-radius:14px;padding:17px;background:linear-gradient(135deg,var(--p),var(--b));color:#fff;font-size:16px;font-weight:850;cursor:pointer;box-shadow:0 10px 25px rgba(93,86,230,.18)}.ctanote{text-align:center;color:#878c96;font-size:12px;margin-top:8px}.detailBtn{text-align:center;color:#6152ca;margin-top:14px;font-weight:700;font-size:13px;cursor:pointer}.detail{display:none;border-top:1px solid var(--line);margin-top:16px;padding-top:13px;font-size:13px}.drow{display:flex;justify-content:space-between;gap:20px;padding:5px 0;color:#656b75}.drow strong{color:#25282f;text-align:right}.admin{margin-top:12px;color:#8a8f98;font-size:12px;line-height:1.45}\n.modal{display:none;margin-top:18px;border-top:1px solid var(--line);padding-top:20px}.modal h3{font-size:22px;margin:0 0 5px}.modal p{color:#737984;font-size:14px;margin:0 0 15px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.formgrid input{padding:13px 14px;border:1px solid #dddfe6;border-radius:11px;font-size:14px;outline:0}.formgrid input:focus{border-color:#755fff;box-shadow:0 0 0 3px rgba(117,95,255,.09)}.submit{grid-column:1/-1;margin-top:3px}.legal{grid-column:1/-1;font-size:11px;color:#969ba4;line-height:1.4}\n@media(max-width:880px){.shell{grid-template-columns:1fr}.wrap{padding-top:34px}.formgrid{grid-template-columns:1fr}.submit,.legal{grid-column:auto}}@media(max-width:560px){.employment-grid,.programs,.groupInputs,.breakdown{grid-template-columns:1fr}.allocHeader{display:block}.allocStatus{display:inline-block;margin-top:5px}}\n\n.program{font:inherit;text-align:left;background:white;color:inherit}.detailBtn{display:block;width:100%;border:0;background:none;padding:12px;font-family:inherit}\n:focus-visible{outline:3px solid #4f82ff!important;outline-offset:3px}.formgrid{min-width:0}.formgrid input{min-width:0;width:100%}.card{min-width:0}.big{overflow-wrap:anywhere}\n@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}\n.employment-card,.gfield{min-width:0}.numrow input{width:0}.numrow button{flex-shrink:0}\n</style></head>\n<body><main class=\"wrap\">\n<span class=\"pill\">Vzdělávání pro firmy 2026–2028</span>\n<h2>Kolik může vaše firma získat na AI vzdělávání?</h2>\n<p class=\"lead\">Zadejte počet lidí na HPP a IČO, rozdělte je do skupin po maximálně 15 účastnících a zvolte rozsah programu.</p>\n<div class=\"trust\">5,0 / 5 na Google · 40 recenzí klientů · kompletní pomoc s administrací</div>\n\n<div class=\"shell\">\n<section class=\"card\">\n<div class=\"step\">Krok 1</div><div class=\"q\">Koho chcete proškolit?</div>\n<div class=\"employment-grid\">\n  <div class=\"employment-card\"><h3>HPP</h3><p>Vzdělávání + mzdový příspěvek.</p><div class=\"numrow\"><button id=\"hppMinus\" aria-label=\"Odebrat HPP\">−</button><input id=\"hpp\" aria-label=\"Počet lidí na HPP\" type=\"number\" min=\"0\" value=\"15\"><button id=\"hppPlus\" aria-label=\"Přidat HPP\">+</button></div></div>\n  <div class=\"employment-card\"><h3>IČO</h3><p>Pouze příspěvek na vzdělávání.</p><div class=\"numrow\"><button id=\"icoMinus\" aria-label=\"Odebrat IČO\">−</button><input id=\"ico\" aria-label=\"Počet lidí na IČO\" type=\"number\" min=\"0\" value=\"0\"><button id=\"icoPlus\" aria-label=\"Přidat IČO\">+</button></div></div>\n</div>\n<div class=\"eligibility-note\">Jedna školicí skupina může mít maximálně <strong>15 osob celkem</strong>. Počet skupin se vytvoří automaticky podle celkového počtu lidí, jejich složení HPP/IČO si ale nastavíte ručně.</div>\n\n<div class=\"step\">Krok 2</div>\n<div class=\"allocHeader\"><div class=\"q\" style=\"margin-bottom:0\">Rozdělte lidi do skupin</div><div class=\"allocStatus\" id=\"allocStatus\">—</div></div>\n<div class=\"manualGroups\" id=\"manualGroups\"></div>\n<div class=\"remainder\" id=\"remainder\"></div>\n<div class=\"helperRow\"><button class=\"helperBtn\" id=\"autoFill\">Automaticky rozdělit</button><button class=\"helperBtn\" id=\"clearGroups\">Vynulovat skupiny</button></div>\n\n<div style=\"height:24px\"></div>\n<div class=\"step\">Krok 3</div><div class=\"q\">Jak intenzivní program zvažujete?</div>\n<div class=\"programs\">\n<button type=\"button\" class=\"program active\" aria-pressed=\"true\" data-h=\"50\"><strong>50 hodin</strong><p>Praktický program pro systematické zavedení AI. <b>299 000 Kč / skupina</b></p><span class=\"badge\">Nejčastější volba</span></button>\n<button type=\"button\" class=\"program\" aria-pressed=\"false\" data-h=\"80\"><strong>80 hodin</strong><p>Více prostoru pro automatizace a vlastní projekty. <b>479 000 Kč / skupina</b></p><span class=\"badge\">Vyšší podpora</span></button>\n</div>\n</section>\n\n<section class=\"card\">\n<div class=\"result\"><div class=\"kicker\">Pro vaši firmu může být ve hře až</div><div class=\"big\" id=\"total\">358 643 Kč</div><div class=\"sum\" id=\"summary\">15 HPP + 0 IČO · 1 skupina · 50 hodin</div></div>\n<div class=\"breakdown\">\n  <div class=\"mini\"><b id=\"education\">195 548 Kč</b><span>na vzdělávání</span></div>\n  <div class=\"mini\"><b id=\"wage\">163 095 Kč</b><span>na mzdové náklady HPP</span></div>\n  <div class=\"mini\"><b id=\"trainingPrice\">299 000 Kč</b><span id=\"trainingPriceNote\">naše cena školení · 299 000 Kč / skupina při 50 h</span></div>\n  <div class=\"mini\"><b id=\"adminFee\">43 037 Kč</b><span>cena za vyřízení dotace · 12 % z celkové dotace</span></div>\n  <div class=\"mini balance\" id=\"balanceCard\"><b id=\"companyBalance\">16 605 Kč</b><span>celkový zůstatek pro firmu po odečtení školení a vyřízení dotace</span></div>\n</div>\n<div class=\"insight\" id=\"insight\"></div>\n<div class=\"groupsTitle\">Kalkulace po skupinách</div><div class=\"groups\" id=\"groups\"></div>\n<button class=\"cta\" id=\"leadCta\">Ověřit nárok a získat přesný rozpočet</button><div class=\"ctanote\">Nezávazně · výpočet ověří dotační specialista</div>\n<button type=\"button\" class=\"detailBtn\" id=\"detailBtn\" aria-expanded=\"false\" aria-controls=\"detail\">Jak jsme částku spočítali?</button><div class=\"detail\" id=\"detail\"></div>\n<div class=\"admin\">Cena 50hodinového školení je <strong>299 000 Kč za jednu skupinu</strong> a cena 80hodinového školení je <strong>479 000 Kč za jednu skupinu</strong>. Cena za kompletní vyřízení dotace je <strong>12 % z celkové částky dotace</strong>. Celkový zůstatek pro firmu počítáme jako <strong>celková dotace − cena školení − cena za vyřízení dotace</strong>. Výpočet je orientační a skutečný nárok závisí na splnění podmínek programu.</div>\n<div class=\"modal\" id=\"leadForm\"><h3>Kam vám máme poslat přesný propočet?</h3><p>Ověříme základní podmínky a navrhneme vhodnou variantu pro vaši firmu.</p><form class=\"formgrid\" id=\"quoteForm\"><input name=\"name\" aria-label=\"Jméno a příjmení\" autocomplete=\"name\" required placeholder=\"Jméno a příjmení\"><input name=\"company\" aria-label=\"Firma\" autocomplete=\"organization\" required placeholder=\"Firma\"><input name=\"email\" aria-label=\"Pracovní e-mail\" autocomplete=\"email\" required type=\"email\" placeholder=\"Pracovní e-mail\"><input name=\"phone\" aria-label=\"Telefon (volitelné)\" autocomplete=\"tel\" type=\"tel\" placeholder=\"Telefon (volitelné)\"><button type=\"submit\" class=\"cta submit\">Chci ověřit svůj výpočet</button><div class=\"legal\">Odesláním formuláře nám předáváte údaje pro vyřízení této poptávky. <a href=\"https://aikonic.cz/ochrana-udaju\" target=\"_blank\" rel=\"noopener\">Ochrana údajů</a></div><input name=\"_gotcha\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\" style=\"display:none\"><p id=\"quoteStatus\" role=\"status\" class=\"submit\"></p></form></div>\n</section>\n</div></main>\n<script>\nconst RATE_EDU=260.73, RATE_WAGE=217.46, ADMIN_RATE=.12, GROUP_MAX=15, TRAINING_PRICE_50=299000, TRAINING_PRICE_80=479000;\nlet hours=50, allocations=[];\nconst hpp=document.getElementById('hpp'), ico=document.getElementById('ico');\nconst money=n=>new Intl.NumberFormat('cs-CZ',{style:'currency',currency:'CZK',maximumFractionDigits:0}).format(Math.round(n));\nconst num=v=>Math.max(0,parseInt(v)||0);\nfunction totals(){return {hpp:num(hpp.value),ico:num(ico.value)}}\nfunction groupCount(){const t=totals();const n=t.hpp+t.ico;return n===0?0:Math.ceil(n/GROUP_MAX)}\nfunction ensureGroups(){\n  const need=groupCount();\n  while(allocations.length<need) allocations.push({hpp:0,ico:0});\n  if(allocations.length>need) allocations=allocations.slice(0,need);\n  clampAllocationsToTotals();\n}\nfunction clampAllocationsToTotals(){\n  const t=totals();\n  let usedH=0,usedI=0;\n  allocations.forEach(g=>{\n    g.hpp=Math.max(0,num(g.hpp)); g.ico=Math.max(0,num(g.ico));\n    if(usedH+g.hpp>t.hpp) g.hpp=Math.max(0,t.hpp-usedH);\n    usedH+=g.hpp;\n    if(usedI+g.ico>t.ico) g.ico=Math.max(0,t.ico-usedI);\n    usedI+=g.ico;\n    if(g.hpp+g.ico>GROUP_MAX){\n      const overflow=g.hpp+g.ico-GROUP_MAX;\n      const cutI=Math.min(g.ico,overflow); g.ico-=cutI;\n      const left=overflow-cutI; if(left>0) g.hpp=Math.max(0,g.hpp-left);\n    }\n  });\n}\nfunction usedTotals(){return allocations.reduce((a,g)=>({hpp:a.hpp+g.hpp,ico:a.ico+g.ico}),{hpp:0,ico:0})}\nfunction remaining(){const t=totals(),u=usedTotals();return {hpp:Math.max(0,t.hpp-u.hpp),ico:Math.max(0,t.ico-u.ico)}}\nfunction groupLabel(n){return n===0?'žádná skupina':n===1?'1 skupina':n<5?`${n} skupiny`:`${n} skupin`}\nfunction changeGroup(idx,type,delta){\n  const t=totals(), u=usedTotals(), g=allocations[idx];\n  if(!g)return;\n  if(delta>0){\n    const remType=type==='hpp'?t.hpp-u.hpp:t.ico-u.ico;\n    if(remType<=0 || g.hpp+g.ico>=GROUP_MAX)return;\n    g[type]++;\n  }else if(delta<0 && g[type]>0){g[type]--;}\n  render();\n}\nfunction setGroupValue(idx,type,value){\n  const g=allocations[idx]; if(!g)return;\n  const old=g[type]; g[type]=Math.max(0,num(value));\n  if(g.hpp+g.ico>GROUP_MAX) g[type]=Math.max(0,GROUP_MAX-g[type==='hpp'?'ico':'hpp']);\n  const t=totals(); const u=usedTotals();\n  if(u[type]>t[type]) g[type]=Math.max(0,g[type]-(u[type]-t[type]));\n  if(Number.isNaN(g[type])) g[type]=old;\n  render();\n}\nfunction autoFill(){\n  const t=totals(); allocations=Array.from({length:groupCount()},()=>({hpp:0,ico:0}));\n  let rh=t.hpp,ri=t.ico;\n  allocations.forEach(g=>{let cap=GROUP_MAX;g.hpp=Math.min(rh,cap);rh-=g.hpp;cap-=g.hpp;g.ico=Math.min(ri,cap);ri-=g.ico;});\n  render();\n}\nfunction clearGroups(){allocations=Array.from({length:groupCount()},()=>({hpp:0,ico:0}));render()}\nfunction renderManualGroups(){\n  const t=totals(),u=usedTotals(),rem=remaining();\n  const host=document.getElementById('manualGroups');\n  if(!allocations.length){host.innerHTML='<div class=\"editGroup\"><div class=\"groupMeta\">Zadejte alespoň 1 osobu na HPP nebo IČO.</div></div>';}\n  else host.innerHTML=allocations.map((g,idx)=>{\n    const count=g.hpp+g.ico,free=GROUP_MAX-count,full=count===GROUP_MAX;\n    const hCanPlus=(t.hpp-u.hpp)>0 && free>0, iCanPlus=(t.ico-u.ico)>0 && free>0;\n    return `<div class=\"editGroup\">\n      <div class=\"editHead\"><strong>Skupina ${idx+1}</strong><span class=\"capacity ${full?'full':''}\">${count}/${GROUP_MAX} osob</span></div>\n      <div class=\"groupInputs\">\n        <div class=\"gfield\"><label>HPP</label><div class=\"numrow\"><button onclick=\"changeGroup(${idx},'hpp',-1)\" ${g.hpp===0?'disabled':''}>−</button><input aria-label=\"Skupina ${idx+1} HPP\" type=\"number\" min=\"0\" max=\"15\" value=\"${g.hpp}\" onchange=\"setGroupValue(${idx},'hpp',this.value)\"><button onclick=\"changeGroup(${idx},'hpp',1)\" ${hCanPlus?'':'disabled'}>+</button></div></div>\n        <div class=\"gfield\"><label>IČO</label><div class=\"numrow\"><button onclick=\"changeGroup(${idx},'ico',-1)\" ${g.ico===0?'disabled':''}>−</button><input aria-label=\"Skupina ${idx+1} IČO\" type=\"number\" min=\"0\" max=\"15\" value=\"${g.ico}\" onchange=\"setGroupValue(${idx},'ico',this.value)\"><button onclick=\"changeGroup(${idx},'ico',1)\" ${iCanPlus?'':'disabled'}>+</button></div></div>\n      </div></div>`;\n  }).join('');\n  const complete=rem.hpp===0&&rem.ico===0;\n  const status=document.getElementById('allocStatus');status.textContent=complete?(allocations.length?'Všichni rozděleni':'0 osob'):`Zbývá ${rem.hpp+rem.ico} osob`;status.className=`allocStatus ${complete?'ok':'warn'}`;\n  document.getElementById('remainder').innerHTML=complete?(allocations.length?'<strong>Hotovo.</strong> Všichni zadaní účastníci jsou přiřazeni do skupin.':'HPP i IČO jsou nastaveny na 0.'):`Zbývá přiřadit: <strong>${rem.hpp} HPP</strong> a <strong>${rem.ico} IČO</strong>.`;\n}\nfunction render(){\n  ensureGroups(); renderManualGroups();\n  const t=totals(), totalPeople=t.hpp+t.ico, groupsN=allocations.length, rem=remaining();\n  const edu=totalPeople*hours*RATE_EDU, wage=t.hpp*hours*RATE_WAGE, total=edu+wage, admin=total*ADMIN_RATE;\n  const trainingUnitPrice=hours===50 ? TRAINING_PRICE_50 : TRAINING_PRICE_80;\n  const trainingPrice=groupsN*trainingUnitPrice;\n  const companyBalance=total-admin-trainingPrice;\n  document.getElementById('total').textContent=money(total);\n  document.getElementById('education').textContent=money(edu);\n  document.getElementById('wage').textContent=money(wage);\n  document.getElementById('adminFee').textContent=money(admin);\n  document.getElementById('trainingPrice').textContent=money(trainingPrice);\n  document.getElementById('trainingPriceNote').textContent=`naše cena školení · ${money(trainingUnitPrice)} / skupina při ${hours} h`;\n  document.getElementById('companyBalance').textContent=money(companyBalance);\n  const balanceCard=document.getElementById('balanceCard');\n  balanceCard.className='mini balance'+(companyBalance<0?' negative':'');\n  balanceCard.querySelector('span').textContent='celkový zůstatek pro firmu po odečtení školení a vyřízení dotace';\n  document.getElementById('summary').textContent=`${t.hpp} HPP + ${t.ico} IČO · ${groupLabel(groupsN)} · ${hours} hodin`;\n  const complete=rem.hpp===0&&rem.ico===0;\n  const insight=document.getElementById('insight');\n  if(totalPeople===0){insight.textContent='Zadejte počet osob na HPP a/nebo IČO. Obě hodnoty mohou být 0.';insight.className='insight';}\n  else if(!complete){insight.textContent=`Celková podpora je spočítaná za všech ${totalPeople} osob. Pro dokončení skupin ještě přiřaďte ${rem.hpp} HPP a ${rem.ico} IČO.`;insight.className='insight warn';}\n  else{insight.textContent=`Rozdělení je kompletní. ${totalPeople} osob je rozděleno do ${groupLabel(groupsN)} po maximálně 15 účastnících.`;insight.className='insight ok';}\n  const rows=allocations.map((g,idx)=>{const people=g.hpp+g.ico,gEdu=people*hours*RATE_EDU,gWage=g.hpp*hours*RATE_WAGE,gTotal=gEdu+gWage;return `<div class=\"groupCard\"><div class=\"groupHead\"><div><strong>Skupina ${idx+1}</strong><div class=\"groupMeta\">${g.hpp} HPP + ${g.ico} IČO · ${people}/15 osob · ${hours} hodin</div></div><span class=\"groupBadge\">${money(gTotal)}</span></div><div class=\"groupNums\"><div class=\"groupNum\"><b>${money(gEdu)}</b><span>vzdělávání</span></div><div class=\"groupNum\"><b>${money(gWage)}</b><span>mzdy HPP</span></div></div></div>`}).join('');\n  document.getElementById('groups').innerHTML=rows||'<div class=\"groupCard\"><div class=\"groupMeta\">Zatím není vytvořena žádná skupina.</div></div>';\n  const u=usedTotals(), allocEdu=(u.hpp+u.ico)*hours*RATE_EDU, allocWage=u.hpp*hours*RATE_WAGE;\n  document.getElementById('detail').innerHTML=`<div class=\"drow\"><span>Počet skupin</span><strong>${groupsN}</strong></div><div class=\"drow\"><span>HPP celkem</span><strong>${t.hpp}</strong></div><div class=\"drow\"><span>IČO celkem</span><strong>${t.ico}</strong></div><div class=\"drow\"><span>Přiřazeno do skupin</span><strong>${u.hpp} HPP + ${u.ico} IČO</strong></div><div class=\"drow\"><span>Rozsah</span><strong>${hours} hodin</strong></div><div class=\"drow\"><span>Vzdělávání (${RATE_EDU.toLocaleString('cs-CZ')} Kč/os.h.)</span><strong>${money(edu)}</strong></div><div class=\"drow\"><span>Mzdy – pouze HPP (${RATE_WAGE.toLocaleString('cs-CZ')} Kč/os.h.)</span><strong>${money(wage)}</strong></div><div class=\"drow\"><span>Celková orientační podpora</span><strong>${money(total)}</strong></div><div class=\"drow\"><span>Cena školení</span><strong>${groupsN} × ${money(trainingUnitPrice)} = ${money(trainingPrice)}</strong></div><div class=\"drow\"><span>Cena za vyřízení dotace (12 % z celkové dotace)</span><strong>${money(admin)}</strong></div><div class=\"drow\"><span><b>Celkový zůstatek pro firmu</b></span><strong>${money(companyBalance)}</strong></div>${!complete?`<div class=\"drow\"><span>Podpora zatím přiřazená ke skupinám</span><strong>${money(allocEdu+allocWage)}</strong></div>`:''}`;\n}\nfunction stepTotal(el,delta){el.value=Math.max(0,(+el.value||0)+delta);ensureGroups();render()}\ndocument.getElementById('hppMinus').onclick=()=>stepTotal(hpp,-1);document.getElementById('hppPlus').onclick=()=>stepTotal(hpp,1);document.getElementById('icoMinus').onclick=()=>stepTotal(ico,-1);document.getElementById('icoPlus').onclick=()=>stepTotal(ico,1);\nhpp.oninput=()=>{ensureGroups();render()};ico.oninput=()=>{ensureGroups();render()};\ndocument.getElementById('autoFill').onclick=autoFill;document.getElementById('clearGroups').onclick=clearGroups;\ndocument.querySelectorAll('.program').forEach(el=>el.onclick=()=>{document.querySelectorAll('.program').forEach(x=>{x.classList.remove('active');x.setAttribute('aria-pressed','false')});el.classList.add('active');el.setAttribute('aria-pressed','true');hours=+el.dataset.h;render()});\ndocument.getElementById('detailBtn').onclick=()=>{const d=document.getElementById('detail');const open=d.style.display==='block';d.style.display=open?'none':'block';document.getElementById('detailBtn').setAttribute('aria-expanded',String(!open));document.getElementById('detailBtn').textContent=open?'Jak jsme částku spočítali?':'Skrýt detail výpočtu'};\ndocument.getElementById('leadCta').onclick=()=>{document.getElementById('leadForm').style.display='block';document.getElementById('leadForm').scrollIntoView({behavior:'smooth',block:'nearest'})};\n// Výchozí ukázka: 15 HPP se automaticky vloží do první skupiny. Další změny lze rozdělovat ručně.\nensureGroups();autoFill();\n\nconst quoteForm=document.getElementById('quoteForm');\nquoteForm.addEventListener('submit',async e=>{\n e.preventDefault();\n const button=quoteForm.querySelector('button[type=\"submit\"]');\n if(button.disabled)return;\n const data=new FormData(quoteForm);\n if(String(data.get('_gotcha')||'').trim())return;\n const rem=remaining();\n const status=document.getElementById('quoteStatus');\n if(groupCount()===0||rem.hpp||rem.ico){status.textContent='Před odesláním zadejte účastníky a rozdělte všechny do skupin.';return;}\n data.set('interest','Dotované vzdělávání');\n data.set('_subject','AIKONIC: Dotační kalkulačka');\n data.set('calculation',JSON.stringify({hpp:totals().hpp,ico:totals().ico,hours,groups:allocations,educationRate:RATE_EDU,wageRate:RATE_WAGE,adminRate:ADMIN_RATE,trainingPricePerGroup:hours===50?TRAINING_PRICE_50:TRAINING_PRICE_80}));\n button.disabled=true;status.textContent='Odesíláme…';\n try{\n  const response=await fetch('https://formspree.io/f/__FORMSPREE_ID__',{method:'POST',body:data,headers:{Accept:'application/json'}});\n  if(!response.ok)throw Error('send');\n  quoteForm.innerHTML='<p role=\"status\" class=\"submit\">Děkujeme. Poptávku i výpočet jsme přijali a ozveme se vám.</p>';\n }catch{status.textContent='Odeslání se nezdařilo. Zkuste to znovu nebo napište na kurzy@aikonic.cz. Údaje zůstaly zachované.';button.disabled=false;}\n});\n</script></body></html>"